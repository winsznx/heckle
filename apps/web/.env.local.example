# Copy to .env.local. Contract addresses are also baked into @heckle/shared,
# so the app runs against the live mainnet contracts even with these blank.
NEXT_PUBLIC_ZG_CHAIN_ID=16661
NEXT_PUBLIC_ZG_RPC_URL=https://evmrpc.0g.ai
NEXT_PUBLIC_ZG_EXPLORER=https://chainscan.0g.ai

# WalletConnect Cloud project id (free at https://cloud.reown.com). Optional.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_HECKLE_CHARACTERS=0xfFB4A91Ff9C8dD16d9b0e0665d869392C8fCC0bc
NEXT_PUBLIC_HECKLE_EVENTS=0x30F9cF192A93C817d152606225a9C3DEC1d1B616
NEXT_PUBLIC_HECKLE_TAKES=0x06c2d42c2fA90897138ddeBa9f2Bc6CcF064d2BD
NEXT_PUBLIC_HECKLE_BRACKETS=0xa1139baE1bdC2FC94A400bc8097342dB0A0f3E6B

# Server-side only (the /api/upload-personality and /api/upload-bracket routes
# sign + pay the 0G Storage fee).
ZG_RPC_URL=https://evmrpc.0g.ai
ZG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
AGENT_PRIVATE_KEY=

# Demo videos — set to the YouTube id or URL after recording.
# _R32 shows on top (autoplays); the group-stage one shows below it.
NEXT_PUBLIC_DEMO_VIDEO_ID_R32=
NEXT_PUBLIC_DEMO_VIDEO_ID=KE4Lg9v5Vq8
