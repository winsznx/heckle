{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --no-frozen-lockfile --filter @heckle/web... && pnpm --filter @heckle/web build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @heckle/web start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
